# DevImpact AI — environment variables
# Copy to `.env` in the repo root: `cp .env.example .env`.
# The API, worker, Prisma CLI and seed script all load this root file automatically.
# Variables already set in your shell/CI/Docker take precedence over this file.

# ─── API & worker (apps/api, validated by apps/api/src/config/env.ts) ────────
# NODE_ENV defaults to development; don't set it here (exporting it would leak into `next build`).

# REQUIRED. PostgreSQL connection string.
DATABASE_URL=postgresql://devimpact:devimpact_password@localhost:5432/devimpact
# REQUIRED. Redis connection string (BullMQ queues + health check).
REDIS_URL=redis://localhost:6379

# HTTP port of the API (default 4000). `PORT` is accepted as a fallback for PaaS hosts.
API_PORT=4000
# Public URL of the web app: CORS origin and GitHub OAuth redirect base (default http://localhost:3000).
WEB_URL=http://localhost:3000

# Run BullMQ processors inside the API process (default true, convenient for local dev).
# Docker Compose sets this to false and runs a dedicated `worker` service (node dist/worker.js).
RUN_WORKER_IN_API=true
# Optional: file the worker touches every 10s; used by the compose worker healthcheck.
# WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat

# Optional: Claude API key. Without it the app runs, but AI generation requests fail.
ANTHROPIC_API_KEY=
# Optional: override the Anthropic API base URL (e.g. a local mock server in tests).
# ANTHROPIC_BASE_URL=http://localhost:4010

# Optional: GitHub OAuth App used to connect a GitHub account as a data source.
# Callback URL: ${WEB_URL}/connect/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Test-only: database used by `npm run test:int` (never point this at real data — it is truncated).
DATABASE_URL_TEST=postgresql://devimpact:devimpact_password@localhost:5432/devimpact_test

# ─── Web (apps/web, validated by apps/web/src/env.ts) ────────────────────────
# Public API base URL, inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Dev only: account the automatic dev-login signs into. Set to the seeded demo account to see
# realistic data without GitHub (`npm run db:seed`). Leave empty for the default empty "Dev User".
NEXT_PUBLIC_DEV_LOGIN_EMAIL=demo@devimpact.dev
# Port for `next dev` / `next start` is passed on the command line (default 3000); there is
# intentionally no PORT variable here so exporting this file doesn't collide with the API (OPS-08).

# Legacy NextAuth route (unused until auth is rebuilt in P05). Only read by apps/web.
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
