# DevImpact AI — environment variables
# Copy to `.env` in the repo root: `cp .env.example .env`.
# The API, worker, web app, Prisma CLI and seed script all load this root file automatically.
# Variables already set in your shell/CI/Docker take precedence over this file.
#
# Values marked "dev-only example" make local setup work out of the box. The API and web app
# REFUSE to start with them when NODE_ENV=production — generate real ones (commands below).

# ─── Shared ──────────────────────────────────────────────────────────────────
# NODE_ENV defaults to development; don't set it here (exporting it would leak into `next build`).

# REQUIRED. PostgreSQL connection string (API, worker and Better Auth in the web app share it).
DATABASE_URL=postgresql://devimpact:devimpact_password@localhost:5432/devimpact
# Public URL of the web app (comma-separated list allowed; the first one is canonical). Used for
# the API's CORS allow-list, the GitHub App callback, Better Auth's base URL and the JWT issuer.
WEB_URL=http://localhost:3000

# ─── Authentication (ADR-0003) ───────────────────────────────────────────────
# Better Auth (web): session signing + encryption of sign-in OAuth tokens and JWT private keys.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Optional: defaults to WEB_URL.
# BETTER_AUTH_URL=http://localhost:3000
# API tokens: 15-minute EdDSA JWTs minted by the web app, verified by the API via JWKS.
# Defaults: issuer = WEB_URL, audience = devimpact-api, JWKS = ${WEB_URL}/api/auth/jwks.
# In Docker Compose the API reaches the web app as http://web:3000 (set there).
# AUTH_JWT_ISSUER=http://localhost:3000
# AUTH_JWT_AUDIENCE=devimpact-api
# AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# Sign in with GitHub — an OAuth App (identity only: read:user user:email).
# Callback URL: ${WEB_URL}/api/auth/callback/github   (see README → Authentication setup)
GITHUB_SIGNIN_CLIENT_ID=
GITHUB_SIGNIN_CLIENT_SECRET=
# Sign in with Google — OAuth client. Redirect URI: ${WEB_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev login (sign in as a seeded user without OAuth). Only honoured when NODE_ENV is not
# production; a production build returns 404 for /api/dev-login regardless of this value.
ENABLE_DEV_LOGIN=true

# ─── API & worker (apps/api, validated by apps/api/src/config/env.ts) ────────
# REQUIRED. Redis connection string (BullMQ queues, rate limits, OAuth state nonces, health).
REDIS_URL=redis://localhost:6379
# HTTP port of the API (default 4000). `PORT` is accepted as a fallback for PaaS hosts.
API_PORT=4000
# Log level: fatal | error | warn | info (default) | debug | trace | silent.
# LOG_LEVEL=info

# Run BullMQ processors inside the API process (default true, convenient for local dev).
# Docker Compose sets this to false and runs a dedicated `worker` service (node dist/worker.js).
RUN_WORKER_IN_API=true
# Optional: file the worker touches every 10s; used by the compose worker healthcheck.
# WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat

# REQUIRED. Provider tokens are encrypted at rest with AES-256-GCM (ADR-0005).
# Comma-separated "<version>:<base64 32-byte key>" list; the active one encrypts, all decrypt.
# Generate a key: openssl rand -base64 32     Rotation: README → Token key rotation.
TOKEN_ENCRYPTION_KEYS=1:ZGV2LW9ubHktdG9rZW4ta2V5LWRvLW5vdC11c2UtISE=
TOKEN_ENCRYPTION_ACTIVE_KEY=1
# REQUIRED. HMAC secret (32+ chars) for the GitHub connect `state` parameter.
# Generate: openssl rand -base64 48
OAUTH_STATE_SECRET=dev-only-oauth-state-secret-change-me-0123456789

# GitHub App = the data source (read-only; see README → GitHub App setup). Optional for local
# work on seed data; "Connect GitHub" returns a clear error until these are set.
# Callback URL: ${WEB_URL}/integrations/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# App private key (installation tokens). PEM as-is, with literal \n escapes, or base64 of the PEM;
# alternatively mount the .pem file and point GITHUB_APP_PRIVATE_KEY_FILE at it.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Webhook secret configured on the GitHub App (HMAC of every delivery to /api/webhooks/github).
# Deliveries are rejected (401) while it is empty. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Optional sync tuning (ADR-0007):
# GITHUB_REQUEST_RETRIES=3              retries for transient GitHub errors (5xx/network)
# GITHUB_THROTTLING=true                1 s pacing between POSTs per token (@octokit/plugin-throttling)
# SYNC_RATE_LIMIT_MIN_REMAINING=200     pause a sync (WAITING_RATE_LIMIT) below this GitHub budget
# BullMQ key prefix (default "devimpact"; "devimpact-test" under NODE_ENV=test so tests never feed
# a running dev worker — OPS-17). Use a distinct prefix per environment sharing one Redis.
# QUEUE_PREFIX=devimpact

# ─── AI (ADR-0009; README → AI configuration) ─────────────────────────────────
# Optional: Claude API key. Without it the app runs, but AI generation requests fail with
# 503 UPSTREAM_UNAVAILABLE { reason: 'not_configured' } (cached documents still load).
ANTHROPIC_API_KEY=
# Optional: override the Anthropic API base URL (test mode). Local mock without a key:
#   npm run ai:mock --workspace=apps/api   → ANTHROPIC_BASE_URL=http://127.0.0.1:4010, ANTHROPIC_API_KEY=mock
# ANTHROPIC_BASE_URL=http://127.0.0.1:4010
# Model ids (the only place they are configured): documents / quick actions + repair.
# ANTHROPIC_MODEL_DEFAULT=claude-opus-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Thinking depth per tier (low | medium | high | xhigh | max).
# AI_EFFORT_DEFAULT=medium
# AI_EFFORT_FAST=low
# Server-side refusal fallback on the default tier (Claude API only).
# AI_FALLBACKS_ENABLED=true
# Per-attempt timeouts (ms) and retries for 429/5xx/overloaded/connection errors only.
# AI_TIMEOUT_MS=180000
# AI_QUICK_TIMEOUT_MS=20000
# AI_MAX_RETRIES=2
# AI_RETRY_BASE_MS=1000
# Parallel `ai` jobs per worker process; Redis retention of document event streams (SSE resume).
# AI_WORKER_CONCURRENCY=4
# AI_STREAM_TTL_SECONDS=3600
# Optional JSON overrides of the plan limits (PRD §6) and of the cost-estimate price table.
# ENTITLEMENTS_JSON={"FREE":{"aiGenerationsPerMonth":15,"aiQuickPerMonth":100}}
# AI_PRICES_JSON={"claude-sonnet-5-5":{"input":2,"output":10}}

# Test-only: database used by `npm run test:int` (never point this at real data — it is truncated).
DATABASE_URL_TEST=postgresql://devimpact:devimpact_password@localhost:5432/devimpact_test

# ─── Web (apps/web, validated by apps/web/src/env.ts) ────────────────────────
# Public API base URL, inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Server-side API base URL for Server Components (prefetching /me, `/` and `/onboarding` redirects).
# Optional: defaults to NEXT_PUBLIC_API_URL. Set it when the web server reaches the API on another
# address than the browser does (Docker Compose sets http://api:4000/api).
# API_INTERNAL_URL=
# Port for `next dev` / `next start` is passed on the command line (default 3000); there is
# intentionally no PORT variable here so exporting this file doesn't collide with the API (OPS-08).
