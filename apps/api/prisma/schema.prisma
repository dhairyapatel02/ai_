generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Migrate) and the driver adapter (runtime), Prisma 7.
datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum Provider {
  GITHUB
  GITLAB
  JIRA
  LINEAR
}

// OAUTH_APP = legacy v0.1 rows only (migrated to NEEDS_REAUTH, ADR-0004).
enum IntegrationMechanism {
  GITHUB_APP
  OAUTH_APP
}

enum IntegrationStatus {
  ACTIVE
  NEEDS_REAUTH
  SUSPENDED
  DISCONNECTED
  ERROR
}

enum PeriodType {
  MONTH
  QUARTER
  HALF
  YEAR
  CUSTOM
}

enum DocumentType {
  RESUME
  APPRAISAL
  PROMOTION
  KPI
}

enum PRState {
  OPEN
  CLOSED
  MERGED
}

enum ReviewState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
}

enum SyncTrigger {
  INITIAL
  MANUAL
  SCHEDULED
  WEBHOOK
  RECONNECT
}

enum SyncKind {
  BACKFILL
  INCREMENTAL
  TARGETED
}

enum SyncStatus {
  QUEUED
  RUNNING
  WAITING_RATE_LIMIT
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum SyncStage {
  PREPARE
  REPOSITORIES
  AUTHORED_PRS
  REVIEWED_PRS
  COMMITS
  PERSIST
  ROLLUPS
  DONE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

// ───────────── Identity (Better Auth, ADR-0003) ─────────────
// Reconciled with `npx auth@1.7.25 generate` (Better Auth 1.7.25). Ids are generated by Prisma
// (`advanced.database.generateId: false` in apps/web/src/lib/auth.ts).
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String
  image         String?  @map("avatar") // keeps the v0.1 column
  plan          Plan     @default(FREE) // Better Auth additionalField (input: false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessions     Session[]
  accounts     Account[]
  settings     UserSettings?
  integrations Integration[]
  repositories Repository[]
  commits      Commit[]
  pullRequests PullRequest[]
  reviews      PullRequestReview[]
  issues       Issue[]
  syncRuns     SyncRun[]
  documents    GeneratedDocument[]
  impactScores ImpactScore[]
  snapshots    MetricSnapshot[]
  legacyScores ImpactScoreLegacy[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Sign-in identities only (NOT data sources). OAuth tokens are encrypted by Better Auth.
model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  providerId            String    @map("provider_id") // "github" | "google" | "credential" (dev only)
  accountId             String    @map("account_id") // provider's user id
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String? // dev-login users only
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth JWT plugin signing keys (private key encrypted with BETTER_AUTH_SECRET).
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  alg        String?
  crv        String?
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@map("jwks")
}

model UserSettings {
  userId                String     @id @map("user_id")
  timezone              String     @default("UTC") // IANA; validated with Intl
  currentRole           String?    @map("current_role") @db.VarChar(100)
  careerLevel           String?    @map("career_level") @db.VarChar(100)
  targetRole            String?    @map("target_role") @db.VarChar(100)
  defaultPeriodType     PeriodType @default(MONTH) @map("default_period_type")
  digestEnabled         Boolean    @default(false) @map("digest_enabled")
  digestDayOfWeek       Int        @default(1) @map("digest_day_of_week")
  digestHourLocal       Int        @default(9) @map("digest_hour_local")
  notifySyncFailures    Boolean    @default(true) @map("notify_sync_failures")
  notifyDocumentReady   Boolean    @default(false) @map("notify_document_ready")
  aiRedactPrivateRepos  Boolean    @default(false) @map("ai_redact_private_repos")
  onboardingStep        String?    @map("onboarding_step")
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ───────────── Integrations (data sources, ADR-0004/0005) ─────────────
model Integration {
  id                    String               @id @default(cuid())
  userId                String
  provider              Provider
  mechanism             IntegrationMechanism @default(GITHUB_APP)
  externalAccountId     String?              @map("external_account_id") // GitHub user node id
  externalLogin         String?              @map("external_login")
  displayName           String?              @map("display_name")
  avatarUrl             String?              @map("avatar_url")
  status                IntegrationStatus    @default(ACTIVE)
  statusReason          String?              @map("status_reason")
  /// "v<keyVersion>.<iv>.<ciphertext>.<tag>" base64url, AES-256-GCM (ADR-0005). Never selected by list queries.
  accessTokenEnc        String?              @map("access_token_enc")
  refreshTokenEnc       String?              @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime?            @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?            @map("refresh_token_expires_at")
  permissions           Json                 @default("{}")
  syncCursor            Json                 @default("{}") @map("sync_cursor")
  backfillFrom          DateTime?            @map("backfill_from")
  lastSyncedAt          DateTime?            @map("last_synced_at")
  lastSuccessfulSyncAt  DateTime?            @map("last_successful_sync_at")
  scheduleSlotMinute    Int                  @default(0) @map("schedule_slot_minute")
  disconnectedAt        DateTime?            @map("disconnected_at")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  installations GitHubInstallation[]
  repositories  Repository[]
  commits       Commit[]
  prs           PullRequest[]
  reviews       PullRequestReview[]
  issues        Issue[]
  syncRuns      SyncRun[]

  @@unique([provider, externalAccountId]) // one GitHub account -> one DevImpact user
  @@index([userId, provider])
  @@index([status, scheduleSlotMinute])
  @@map("integrations")
}

model GitHubInstallation {
  id                  String      @id @default(cuid())
  integrationId       String      @map("integration_id")
  installationId      BigInt      @map("installation_id")
  accountLogin        String      @map("account_login")
  accountType         String      @map("account_type") // "User" | "Organization"
  repositorySelection String      @map("repository_selection") // "all" | "selected"
  suspendedAt         DateTime?   @map("suspended_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  integration         Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, installationId])
  @@index([installationId])
  @@map("github_installations")
}

// ───────────── Activity (DATA_MODEL_V2 §3, migrations P06-1/P06-2) ─────────────
// Every row belongs to one user; provider records are keyed by provider node id *and* a natural
// key so upserts are idempotent and legacy v0.1 rows are matched (DATA_MODEL_V2 §1).
model Repository {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  integrationId   String    @map("integration_id")
  externalId      String    @map("external_id") // GitHub node id; "legacy:<fullName>" until first v2 sync
  fullName        String    @map("full_name") // owner/name
  ownerLogin      String    @map("owner_login")
  name            String
  isPrivate       Boolean   @default(false) @map("is_private")
  isFork          Boolean   @default(false) @map("is_fork")
  isArchived      Boolean   @default(false) @map("is_archived")
  defaultBranch   String?   @map("default_branch")
  htmlUrl         String?   @map("html_url")
  installationId  BigInt?   @map("installation_id") // null = reachable as public repo only
  accessible      Boolean   @default(true)
  included        Boolean   @default(true)
  inclusionSource String    @default("DEFAULT") @map("inclusion_source") // DEFAULT | USER
  commitCursor    DateTime? @map("commit_cursor")
  lastActivityAt  DateTime? @map("last_activity_at")
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration  Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  pullRequests PullRequest[]
  commits      Commit[]

  @@unique([integrationId, externalId])
  @@unique([integrationId, fullName])
  @@index([userId, included])
  @@map("repositories")
}

model Commit {
  id                 String    @id @default(cuid())
  userId             String
  integrationId      String
  repositoryId       String    @map("repository_id")
  sha                String
  messageHeadline    String    @map("message_headline")
  messageBody        String?   @map("message_body")
  branch             String // default branch name the commit was found on
  authoredAt         DateTime  @map("authored_at")
  committedAt        DateTime? @map("committed_at")
  additions          Int       @default(0)
  deletions          Int       @default(0)
  changedFiles       Int?      @map("changed_files")
  parentsCount       Int       @default(1) @map("parents_count")
  associatedPrNumber Int?      @map("associated_pr_number")
  authorExternalId   String?   @map("author_external_id")
  syncedAt           DateTime  @default(now()) @map("synced_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  repository  Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, sha]) // de-duplicates forks/mirrors
  @@index([userId, authoredAt])
  @@index([repositoryId, authoredAt])
  @@map("commits")
}

/// One row per (user, PR). `isAuthoredByUser = false` rows are PRs the user reviewed; they store
/// no body and no third-party review content (data minimisation, ARCHITECTURE_V2 §12).
model PullRequest {
  id                    String    @id @default(cuid())
  userId                String
  integrationId         String
  repositoryId          String    @map("repository_id")
  externalId            String?   @map("external_id") // node id (null for legacy rows until refreshed)
  number                Int
  title                 String
  body                  String? // stored only when isAuthoredByUser
  url                   String?
  state                 PRState
  isDraft               Boolean   @default(false) @map("is_draft")
  isAuthoredByUser      Boolean   @map("is_authored_by_user")
  authorExternalId      String?   @map("author_external_id")
  authorLogin           String?   @map("author_login")
  labels                String[]  @default([])
  baseRef               String?   @map("base_ref")
  createdAtRemote       DateTime  @map("created_at_remote") // GitHub createdAt (v0.1 "timestamp")
  readyForReviewAt      DateTime? @map("ready_for_review_at")
  mergedAt              DateTime?
  closedAt              DateTime? @map("closed_at")
  updatedAtRemote       DateTime? @map("updated_at_remote")
  additions             Int?
  deletions             Int?
  changedFiles          Int?      @map("changed_files")
  commitsCount          Int?      @map("commits_count")
  // reviews received (authored PRs only; aggregates, no third-party content)
  firstReviewAt         DateTime? @map("first_review_at")
  reviewersCount        Int?      @map("reviewers_count")
  approvalsCount        Int?      @map("approvals_count")
  changesRequestedCount Int?      @map("changes_requested_count")
  // revert detection (KPI_METHODOLOGY §3.2)
  isRevert              Boolean   @default(false) @map("is_revert")
  revertedAt            DateTime? @map("reverted_at")
  revertedByUrl         String?   @map("reverted_by_url")
  legacyStub            Boolean   @default(false) @map("legacy_stub") // v0.1 "PR #n" stub awaiting refresh
  syncedAt              DateTime  @default(now()) @map("synced_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  repository  Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews     PullRequestReview[]

  @@unique([userId, repositoryId, number]) // natural key (matches legacy rows)
  @@unique([userId, externalId])
  @@index([userId, isAuthoredByUser, mergedAt])
  @@index([userId, isAuthoredByUser, createdAtRemote])
  @@index([userId, isAuthoredByUser, closedAt])
  @@index([userId, firstReviewAt])
  @@map("pull_requests")
}

/// Reviews submitted BY the user on other people's PRs (the PR row has isAuthoredByUser = false).
model PullRequestReview {
  id                String      @id @default(cuid())
  userId            String      @map("user_id")
  integrationId     String      @map("integration_id")
  pullRequestId     String      @map("pull_request_id")
  externalId        String      @map("external_id") // review node id; "legacy:<v0.1 id>" for migrated rows
  state             ReviewState
  submittedAt       DateTime    @map("submitted_at")
  hasBody           Boolean     @default(false) @map("has_body")
  commentsCount     Int         @default(0) @map("comments_count") // inline comments in this review
  reviewRequestedAt DateTime?   @map("review_requested_at") // earliest request <= submittedAt
  syncedAt          DateTime    @default(now()) @map("synced_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, submittedAt])
  @@index([pullRequestId])
  @@map("pull_request_reviews")
}

model Issue {
  id            String        @id @default(cuid())
  userId        String
  integrationId String
  title         String
  labels        String[]
  storyPoints   Int?
  priority      IssuePriority @default(NONE)
  status        IssueStatus   @default(TODO)
  projectName   String?
  timestamp     DateTime

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("issues")
}

// ───────────── Sync (ADR-0007) ─────────────
/// Source of truth for sync status, progress and history (survives Redis loss).
model SyncRun {
  id                      String      @id @default(cuid())
  userId                  String      @map("user_id")
  integrationId           String      @map("integration_id")
  trigger                 SyncTrigger
  kind                    SyncKind
  status                  SyncStatus  @default(QUEUED)
  stage                   SyncStage   @default(PREPARE)
  progress                Int         @default(0) // 0..100, from planned work units
  windowFrom              DateTime?   @map("window_from")
  windowTo                DateTime?   @map("window_to")
  counts                  Json        @default("{}") // { repos, prsAuthored, prsReviewed, reviews, commits, created, updated }
  apiCalls                Int         @default(0) @map("api_calls")
  rateLimitRemaining      Int?        @map("rate_limit_remaining")
  resumeAt                DateTime?   @map("resume_at")
  /// Resumable position (slice index, completed stages, work units) for rate-limit pauses.
  checkpoint              Json        @default("{}")
  /// Set when the newest-30-days slice of a backfill is persisted (API_CONTRACT_V2 A-4).
  recentWindowCompletedAt DateTime?   @map("recent_window_completed_at")
  errorCode               String?     @map("error_code")
  errorMessage            String?     @map("error_message") // safe, user-facing
  errors                  Json        @default("[]") // [{ stage, repo?, code, message, at }]
  jobId                   String?     @map("job_id")
  webhookDeliveryId       String?     @map("webhook_delivery_id")
  queuedAt                DateTime    @default(now()) @map("queued_at")
  startedAt               DateTime?   @map("started_at")
  finishedAt              DateTime?   @map("finished_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, queuedAt(sort: Desc)])
  @@index([userId, queuedAt(sort: Desc)])
  @@index([status])
  @@map("sync_runs")
}

/// Global (not user-owned): webhook idempotency + audit. Retained 14 days.
model WebhookDelivery {
  id             String        @id // X-GitHub-Delivery GUID
  provider       Provider
  event          String
  action         String?
  installationId BigInt?       @map("installation_id")
  status         WebhookStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime      @default(now()) @map("received_at")
  processedAt    DateTime?     @map("processed_at")

  @@index([receivedAt])
  @@map("webhook_deliveries")
}

model GeneratedDocument {
  id        String       @id @default(cuid())
  userId    String
  type      DocumentType
  content   Json
  dateRange Json
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("generated_documents")
}

/// v0.1 LLM-generated scores (AI-01), renamed by migration P07-1. Never displayed; dropped in P15.
model ImpactScoreLegacy {
  id              String   @id @default(cuid())
  userId          String
  month           Int
  year            Int
  overall         Float
  featureDelivery Float
  codeQuality     Float
  collaboration   Float
  leadership      Float
  highlights      String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("impact_scores_legacy")
}

// ───────────── Metrics (KPI_METHODOLOGY §4, §6; migration P07-1) ─────────────
/// One row per user per local date with additive counters only (medians/ratios come from the fact
/// tables). Rebuilt by `metrics.recompute`; only days with activity are stored.
model MetricSnapshot {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  date              DateTime @db.Date // local date in `timezone`
  timezone          String
  commits           Int      @default(0)
  prsOpened         Int      @default(0) @map("prs_opened")
  prsMerged         Int      @default(0) @map("prs_merged")
  prsClosedUnmerged Int      @default(0) @map("prs_closed_unmerged")
  reviewsSubmitted  Int      @default(0) @map("reviews_submitted")
  prsReviewed       Int      @default(0) @map("prs_reviewed") // distinct PRs reviewed that day
  reviewComments    Int      @default(0) @map("review_comments")
  achievements      Int      @default(0)
  active            Boolean  @default(false)
  metricsVersion    String   @map("metrics_version")
  computedAt        DateTime @default(now()) @map("computed_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("metric_snapshots")
}

enum ScoreStatus {
  OK
  INSUFFICIENT_DATA
}

/// Lazily computed, cached period metrics + impact score (ADR-0008). `inputs` (§6.6) reproduces the
/// score without the database and doubles as the period-metrics cache for /metrics/kpis.
/// `metrics.recompute` deletes rows whose period overlaps the recomputed range.
model ImpactScore {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  periodType     PeriodType  @map("period_type")
  periodStart    DateTime    @map("period_start") @db.Date
  periodEnd      DateTime    @map("period_end") @db.Date
  timezone       String
  scoreVersion   String      @map("score_version")
  metricsVersion String      @map("metrics_version")
  status         ScoreStatus
  overall        Float?
  delivery       Float?
  quality        Float?
  collaboration  Float?
  ownership      Float?
  inputs         Json
  explanation    String
  computedAt     DateTime    @default(now()) @map("computed_at")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodType, periodStart, periodEnd, scoreVersion])
  @@index([userId, periodStart, periodEnd])
  @@map("impact_scores")
}
