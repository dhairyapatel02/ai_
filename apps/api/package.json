{
  "name": "@devimpact/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.ts",
    "test:int": "jest --config jest.int.config.ts --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:seed:heavy": "tsx prisma/scripts/seed-heavy.ts",
    "metrics:recompute": "tsx prisma/scripts/recompute-metrics.ts",
    "perf:metrics": "tsx prisma/scripts/measure-metrics-perf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@devimpact/shared": "*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@octokit/core": "^6.1.6",
    "@octokit/plugin-retry": "^7.2.1",
    "@octokit/plugin-throttling": "^10.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5.81.0",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "^5.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "fast-check": "^4.10.2",
    "jest": "^30.2.0",
    "pg": "^8.23.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
