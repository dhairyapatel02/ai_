{
  // Type-checking + editor/ESLint config covering sources, tests, seed and tool configs.
  // `nest build` uses tsconfig.build.json (src only).
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*", "prisma/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
