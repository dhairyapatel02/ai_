{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emitted as CommonJS so both NestJS (CommonJS) and Next.js (bundler) can consume dist/.
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": "./dist",
    "rootDir": "./src",
    "isolatedModules": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
